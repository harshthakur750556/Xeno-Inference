{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix ui-canvas run build",
  "outputDirectory": "ui-canvas/dist",
  "installCommand": "npm --prefix ui-canvas install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
